# CloudyAI reads these only if the variable is not already in your shell.
# Never commit a real key — .env is gitignored.

# OpenCode Go plan (default provider). Get it from https://opencode.ai/console
OPENCODE_API_KEY=oc_sk_...

# Command Code Provider API (direct HTTPS). Create the key at
# https://commandcode.ai/settings/keys — this is the API key, not the CLI login.
COMMANDCODE_API_KEY=...

# DeepSeek platform API (alternative provider)
DEEPSEEK_API_KEY=sk-...
