{
  "name": "cloudyai",
  "productName": "CloudyAI",
  "version": "0.2.5",
  "description": "Local-first AI copilot: on-device speech-to-text (CloudyVoice) + DeepSeek / opencode / commandcode answers in an overlay excluded from screen capture.",
  "main": "src/main/index.js",
  "author": "Tanay Mitra",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "check:main": "node scripts/check-main.js",
    "test": "node test/llm.test.js && node test/detection.test.js && node test/tray-icon.test.js && node test/pick.test.js && node test/overlay-render.test.js && node test/cloudyvoice-lifecycle.test.js",
    "make-icon": "node scripts/make-icon.js",
    "test:stt": "node test/cloudyvoice.test.js",
    "test:e2e": "node test/e2e.test.js",
    "bench": "node test/opencodego.bench.js",
    "build:ear": "bash scripts/build-ear.sh",
    "build:audio": "bash scripts/build-audio.sh",
    "build:whisper:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-whisper-win.ps1",
    "get-model": "node scripts/get-model.js",
    "dist": "npm run build:ear && npm run build:audio && electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cloudy.ai",
    "productName": "CloudyAI",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "assets/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "native/CloudyEar/.build/release/CloudyEar",
          "to": "cloudy-ear"
        },
        {
          "from": "native/CloudyAudio/.build/release/CloudyAudio",
          "to": "cloudy-audio"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "CloudyAI listens to the meeting audio so it can transcribe it on-device with CloudyVoice.",
        "NSScreenCaptureUsageDescription": "CloudyAI needs screen access to capture system audio from calls.",
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "vendor/whisper",
          "to": "whisper"
        },
        {
          "from": "vendor/models",
          "to": "models"
        },
        {
          "from": "vendor/mouse",
          "to": "mouse"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CloudyAI",
      "uninstallDisplayName": "CloudyAI",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
